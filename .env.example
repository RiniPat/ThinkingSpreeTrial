# Copy to .env and fill in.
# DO NOT commit your real .env — it's in .gitignore.

# ─── Required ─────────────────────────────────────────────────────────────
# Postgres connection string (Neon, Render Postgres, or local docker)
DATABASE_URL=postgresql://user:password@localhost:5432/thinkingspree

# Express session secret — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-random-32-byte-hex-string-here

# ─── Optional (but needed for Google integrations) ────────────────────────
# See GOOGLE_INTEGRATION_SETUP.md for how to obtain these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/google/oauth/callback

# Where the OAuth callback redirects the user after success.
# In production: https://app.thinkingspree.com
APP_BASE_URL=http://localhost:5000

# ─── Optional (for AI-generated emails) ───────────────────────────────────
AI_INTEGRATIONS_OPENAI_API_KEY=
AI_INTEGRATIONS_OPENAI_BASE_URL=

# ─── Server config ────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
